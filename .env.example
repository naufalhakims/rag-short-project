# Pocket Librarian configuration.
# Copy this file to `.env` and fill in at least one API key. Every other line is
# optional: the commented values are the defaults, and an empty value also
# means "use the default".

# ── Language model ───────────────────────────────────────────────
# Any provider with a key is used. "auto" tries them in the order
# anthropic → groq → google → openai and moves to the next one when a provider
# is rate-limited, down, or has retired the model. Name a provider to put it first.
LLM_PROVIDER=auto
# LLM_FALLBACK=true            # false = only the first provider and its configured model

# Groq — free tier, very fast. Keys: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b      # rewrites follow-up questions

# Google Gemini — free tier. Keys: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# GEMINI_MODEL=                # empty = newest flash-lite model the key can use

# Anthropic Claude — paid. Keys: https://platform.claude.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_FAST_MODEL=        # empty = same as ANTHROPIC_MODEL
# ANTHROPIC_EFFORT=medium      # low | medium | high | xhigh | max

# Any other OpenAI-compatible API (OpenAI, OpenRouter, Ollama, LM Studio…).
# Used only when OPENAI_MODEL is set.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1     # Ollama: http://localhost:11434/v1
# OPENAI_MODEL=

# LLM_TEMPERATURE=0.2
# LLM_MAX_OUTPUT_TOKENS=       # empty = per provider (Groq 1024: its free tier counts
#                              # this against the 8,000 tokens/minute limit)
# LLM_TIMEOUT_SECONDS=30

# ── Retrieval (runs locally, no API key) ─────────────────────────
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2   # "none" = no reranking
#
# Mostly non-English documents? Use a multilingual embedder and turn the
# English-only reranker off. Existing documents are re-indexed automatically.
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RERANKER_MODEL=none

# CHUNK_SIZE=900               # characters per passage (applies to new uploads)
# CHUNK_OVERLAP=120
# TOP_K=6                      # most passages given to the LLM per question
# MIN_PASSAGES=3
# RETRIEVAL_CANDIDATES=24      # per search method, before merging
# RERANK_CANDIDATES=12         # merged candidates the reranker reads
# RERANK_MIN_SCORE=0.005
# HISTORY_TURNS=3              # earlier exchanges the LLM sees

# ── Storage ──────────────────────────────────────────────────────
# DATA_DIR=./data              # database, vector index, model cache, log
# MODEL_DIR=                   # empty = <DATA_DIR>/models
# MAX_UPLOAD_MB=25
